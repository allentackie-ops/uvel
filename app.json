{
  "expo": {
    "name": "Uvel",
    "slug": "uvel",
    "scheme": "uvel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/13230e71-d40b-45c8-8709-176f0c021198",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "com.uvel.dressandshop",
      "supportsTablet": false,
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Uvel photographs looks and you, so it can find the piece and show it on your body before you buy.",
        "NSPhotoLibraryUsageDescription": "Uvel reads photos and screenshots you pick so it can find the clothes and try them on you.",
        "NSMicrophoneUsageDescription": "Video looks from TikTok, Reels, and Snapchat may include sound.",
        "UIUserInterfaceStyle": "Automatic",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "uvel",
              "com.googleusercontent.apps.296904495728-e7k7v6jcshvh976drg33aqc3bec288v0"
            ]
          }
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.uvel.dressandshop",
      "adaptiveIcon": {
        "backgroundColor": "#2A320E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Uvel reads photos and screenshots so it can find the clothes.",
          "cameraPermission": "Uvel photographs looks and you for try-on."
        }
      ],
      "expo-web-browser",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2A320E",
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-video",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "13230e71-d40b-45c8-8709-176f0c021198"
      },
