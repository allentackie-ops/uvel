rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isBrandOwner(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    function isBrandMember(brandId) {
      let brand = get(/databases/$(database)/documents/brands/$(brandId)).data;
      return signedIn() &&
        (brand.ownerId == request.auth.uid ||
         (brand.memberIds is list && brand.memberIds.hasAny([request.auth.uid])));
    }

    function isChatParticipant(data) {
      return signedIn() &&
        (data.buyerId == request.auth.uid ||
         data.sellerId == request.auth.uid ||
         (data.recipientIds is list && data.recipientIds.hasAny([request.auth.uid])));
    }

    match /users/{uid} {
      allow read, create, update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }

    match /brands/{brandId} {
      allow read: if resource.data.verified == true || isBrandOwner(resource.data) || isAdmin();

      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 1 &&
        request.resource.data.members[0].uid == request.auth.uid &&
        request.resource.data.status == "draft" &&
        request.resource.data.verified == false;

      allow update: if isAdmin() ||
        (
          isBrandOwner(resource.data) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.verified == resource.data.verified &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "handle", "tagline", "story", "vertical", "website",
            "instagram", "phone", "whatsapp", "legalName", "registrationId", "contactEmail",
            "country", "logoUri", "bannerKind", "bannerUri", "themeId",
            "custom", "analyticsShared", "members", "memberIds", "inquiryMemberIds", "followers", "follows",
            "views", "likes", "updatedAt"
          ])
        );

      allow delete: if isAdmin();
    }

    match /brandInvites/{inviteId} {
      allow read: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if signedIn() &&
        isBrandOwner(get(/databases/$(database)/documents/brands/$(request.resource.data.brandId)).data) &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.status == "pending";

      allow update: if signedIn() &&
        (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        ) &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.brandId == resource.data.brandId &&
        request.resource.data.toUid == resource.data.toUid;

      allow delete: if false;
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == "listed" ||
        (signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.listedByUid == request.auth.uid));
      allow create: if signedIn() &&
        request.resource.data.listedByUid == request.auth.uid &&
        request.resource.data.brandId is string &&
        request.resource.data.stockQuantity is int &&
        request.resource.data.stockQuantity > 0 &&
        request.resource.data.status in ["owned", "draft", "listed"];
      allow update: if signedIn() &&
        resource.data.listedByUid == request.auth.uid &&
        request.resource.data.listedByUid == resource.data.listedByUid &&
        request.resource.data.brandId == resource.data.brandId &&
        request.resource.data.stockQuantity is int &&
        ((request.resource.data.status in ["owned", "draft", "listed"] && request.resource.data.stockQuantity > 0) ||
         (request.resource.data.status == "archived" && request.resource.data.stockQuantity >= 0) ||
         (request.resource.data.status == "sold" && request.resource.data.stockQuantity == 0)) &&
        request.resource.data.status in ["owned", "draft", "listed", "archived", "sold"];
      allow delete: if signedIn() && resource.data.listedByUid == request.auth.uid;
    }

    match /brandAnalytics/{brandId} {
      allow read, write: if false;
    }

    match /brandAudit/{eventId} {
      allow read: if signedIn() && resource.data.brandId is string && isBrandMember(resource.data.brandId);
      allow create, update, delete: if false;
    }

    match /supportCases/{caseId} {
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid || (resource.data.brandId is string && isBrandMember(resource.data.brandId)));
      allow create, update, delete: if false;
      match /notes/{noteId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/supportCases/$(caseId)).data.brandId is string && isBrandMember(get(/databases/$(database)/documents/supportCases/$(caseId)).data.brandId);
        allow create, update, delete: if false;
      }
    }

    match /brandAnalytics/{brandId}/{document=**} {
      allow read, write: if false;
    }

    match /orders/{orderId} {
      allow read: if signedIn() &&
        (resource.data.buyerId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid ||
         (resource.data.brandId is string && isBrandMember(resource.data.brandId)));

      allow create: if signedIn() &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.status == "pending" &&
        request.resource.data.totalCents is int &&
        request.resource.data.totalCents > 0;

      // Payment status and fulfillment state must be changed by trusted backend code.
      allow update: if false;

      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if isChatParticipant(resource.data);

      allow create: if signedIn() &&
        (request.resource.data.buyerId == request.auth.uid ||
         request.resource.data.sellerId == request.auth.uid);

      allow update: if isChatParticipant(resource.data) &&
        request.resource.data.buyerId == resource.data.buyerId &&
        request.resource.data.sellerId == resource.data.sellerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastText", "lastAt", "lastFrom", "unreadBuyer", "unreadSeller",
          "typingBy", "typingAt", "seenBy", "seenAt", "updatedAt",
          "orderId", "supportCaseId", "contextId"
        ]);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);

        allow create: if isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data) &&
          request.resource.data.from == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 5000;

        allow update: if false;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}